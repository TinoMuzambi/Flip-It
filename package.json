{
  "name": "flip-it",
  "version": "2.0.0",
  "private": true,
  "description": "A private, local-first flashcard app for focused study sessions.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
